# ─────────────────────────────────────────────────────────────────────────────
# ClauseLens — Environment Variables Reference
#
# HOW TO USE:
#   Server: copy this section to server/.env
#   Client: copy the VITE_ section to client/.env (or client/.env.local)
#
# NEVER commit .env files. .env.example IS safe to commit.
# ─────────────────────────────────────────────────────────────────────────────


# ════════════════════════════════════════════════════════
# SERVER  (server/.env)
# ════════════════════════════════════════════════════════

# ── Server runtime ────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ── Authentication ────────────────────────────────────────────────────────────
# Secret used to sign JWTs. Use a strong random value in production.
# Generate one: openssl rand -base64 32
JWT_SECRET=clauselens-dev-secret-change-in-production

# ── AI Provider (optional) ────────────────────────────────────────────────────
# Set GEMINI_API_KEY to use Google Gemini for real document analysis.
# Set OPENAI_API_KEY to use OpenAI GPT-4o instead.
# Leave both blank to use Demo Mode (fully functional, no external calls).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Legacy OpenAI support (used only if GEMINI_API_KEY is not set)
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o

# ── CORS (production only) ────────────────────────────────────────────────────
# Set to your deployed frontend URL when running in production.
# Leave blank for local development (localhost is allowed automatically).
# CLIENT_URL=https://your-frontend-domain.com


# ════════════════════════════════════════════════════════
# CLIENT  (client/.env or client/.env.local)
# ════════════════════════════════════════════════════════

# ── App info ──────────────────────────────────────────────────────────────────
VITE_APP_NAME=ClauseLens
VITE_APP_VERSION=1.0.0

# ── API URL (production only) ─────────────────────────────────────────────────
# In development, Vite proxies /api → http://localhost:3001 automatically.
# In production, set this to your deployed backend URL.
# VITE_API_BASE_URL=https://your-backend-domain.com/api
