# ─────────────────────────────────────────────────────────────────────────────
# ClauseLens — Environment Variables
# Copy this file to .env in the /server directory and fill in real values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ── Authentication ────────────────────────────────────────────────────────────
# Secret used to sign JWTs. Change this to a strong random value in production.
JWT_SECRET=your-strong-secret-here

# ── AI Provider (optional) ────────────────────────────────────────────────────
# If OPENAI_API_KEY is not set, the application automatically uses Demo Mode.
# Demo Mode works without any API key and is fully functional.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# ── CORS ──────────────────────────────────────────────────────────────────────
# URL of the deployed frontend (production only)
# CLIENT_URL=https://your-frontend-domain.com
